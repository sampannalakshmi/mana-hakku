# Copy this file to .env and fill in real values locally.
# NEVER commit .env to Git. NEVER put real secrets in frontend JavaScript.
# All values below are placeholders, not working credentials.

APP_NAME=Mana Hakku Backend
ENVIRONMENT=development

# Supabase PostgreSQL connection string (placeholder). Leave empty to run without a database.
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Reserved for later AI integration. Leave empty for now.
AI_API_KEY=
